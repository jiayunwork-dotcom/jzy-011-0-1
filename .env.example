# Copy to .env or export directly. docker-compose.yml sets these already.

# Listen address
ADDR=:8080

# Storage backend: "memory" (default, history lost on restart) or "postgres"
STORAGE=postgres

# PostgreSQL connection string (used when STORAGE=postgres)
DATABASE_DSN=postgres://ackermann:ackermann@db:5432/ackermann?sslmode=disable

# Accepted instant-center concurrency residual, millimeters
ICR_TOLERANCE_MM=0.000001
